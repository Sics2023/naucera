# Admin login (change these before going live)
ADMIN_EMAIL=admin@naucera.in
ADMIN_PASSWORD=change-this-password
# Long random string used to sign the admin session cookie
SESSION_SECRET=change-me-to-a-long-random-string

# MySQL database (Hostinger: hPanel -> Databases -> MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_naucera
DB_USER=u123456789_naucera
DB_PASSWORD=your-database-password
# Alternatively, a single connection string:
# DATABASE_URL=mysql://user:password@host:3306/dbname

# Set to 0 to start with an empty store instead of sample products/orders
SEED_SAMPLE_DATA=1
