{
  "name": "naucera",
  "version": "0.1.0",
  "private": true,
  "description": "Naucera – coffee & tea premix store with admin dashboard",
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning next dev",
    "build": "NODE_OPTIONS=--disable-warning=ExperimentalWarning next build",
    "start": "NODE_OPTIONS=--disable-warning=ExperimentalWarning next start",
    "lint": "tsc --noEmit",
    "reset-db": "rm -rf data && echo 'Database removed. It will be re-created with sample data on next start.'"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "lucide-react": "^0.544.0",
    "next": "^15.5.28",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3"
  }
}
